# Required production research configuration. Copy to .env and provide a real key.
STUDY_MODE=true
GEMINI_API_KEY=replace-with-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_ATTEMPTS=4
GEMINI_RETRY_BASE_SECONDS=1
RATIONALE_PARSER=gemini
SCENARIO_GENERATOR=deterministic
ONBOARDING_ENABLED=true
ONBOARDING_INTERVIEWER=gemini
ONBOARDING_EXTRACTOR=gemini
ONBOARDING_REVIEWER=gemini
ONBOARDING_EVIDENCE_SCALE=0.75
ONBOARDING_MIXTURE_WEIGHT=0.35
ONBOARDING_SCORE_CLIP=3.0
ONBOARDING_MIN_ACCEPTED_EVIDENCE=2
ONBOARDING_MAXIMUM_TURNS=8
ONBOARDING_MAXIMUM_FOLLOWUPS=2
